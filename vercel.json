{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    { "source": "/about-us/", "destination": "/about/", "statusCode": 301 },
    { "source": "/our-team/", "destination": "/about/#team", "statusCode": 301 },
    { "source": "/projects-we-support/", "destination": "/projects/", "statusCode": 301 },
    { "source": "/agroforestry-regeneration-communities/", "destination": "/projects/agroforestry-regeneration-communities/", "statusCode": 301 },
    { "source": "/tge/", "destination": "/projects/towards-green-environment/", "statusCode": 301 },
    { "source": "/bod/", "destination": "/projects/beyond-organic-design/", "statusCode": 301 },
    { "source": "/how-to-apply-for-funding/", "destination": "/get-support/", "statusCode": 301 },
    { "source": "/abundant-earth-foundation-newsletter-signup/", "destination": "/newsletter/", "statusCode": 301 },
    { "source": "/aef-privacy-policy/", "destination": "/privacy/", "statusCode": 301 },
    { "source": "/category/recent-news/", "destination": "/stories/", "statusCode": 301 },
    { "source": "/podcasts/", "destination": "/resources/", "statusCode": 301 },
    { "source": "/donations/donate-to-agroforestry-regeneration-communities/", "destination": "/donate/?project=agroforestry-regeneration-communities", "statusCode": 301 },
    { "source": "/donations/donate-to-regenerative-holistic-resource-center/", "destination": "/donate/?project=regenerative-holistic-resource-center", "statusCode": 301 },
    { "source": "/donations/donate-to-towards-green-environment/", "destination": "/donate/?project=towards-green-environment", "statusCode": 301 },
    { "source": "/donations/donate-to-beyond-organic-design/", "destination": "/donate/?project=beyond-organic-design", "statusCode": 301 }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
