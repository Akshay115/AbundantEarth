---
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/PageIntro.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Newsletter from '../../components/Newsletter.astro';
import { projects } from '../../lib/content';
const current = projects.filter(p => p.section !== 'past');
const past = projects.filter(p => p.section === 'past');
---
<Layout title="Our projects" description="Meet the locally led projects in Abundant Earth Foundation’s documented network. Explore food forests, youth education, and community resilience.">
  <PageIntro eyebrow="Our work, rooted in place" title="Many communities. One living Earth." description="Discover the people and projects growing food, restoring landscapes, and creating possibilities for the next generation." />
  <section class="section container directory" id="directory">
    <div class="project-group" id="current-projects"><h2 class="group-title">Current Projects</h2><div class="project-grid">{current.map(project => <ProjectCard project={project} />)}</div></div>
    <div class="project-group" id="past-projects"><h2 class="group-title">Past Projects</h2><div class="project-grid">{past.map(project => <ProjectCard project={project} />)}</div></div>
    <p class="section-note">These profiles combine the original curated directory with recovered project pages. For the wider grant and recipient record, <a href="/history/">explore project history</a> or <a href="/history/#map">browse the map</a>. Source-page dates and campaign context are provided on each profile.</p>
  </section>
  <Newsletter />
</Layout>
