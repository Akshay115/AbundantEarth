---
import Layout from '../../layouts/Layout.astro';
import Photo from '../../components/Photo.astro';
import Icon from '../../components/Icon.astro';
import Newsletter from '../../components/Newsletter.astro';
import { stories, projects } from '../../lib/content';
export function getStaticPaths() { return stories.map(story => ({ params: { slug: story.slug }, props: { story } })); }
const { story } = Astro.props;
const project = projects.find(p => p.slug === story.project)!;
---
<Layout title={story.title} description={story.summary} image={`/images/${story.image}-1600.webp`}><article class="container"><header class="article-header"><p class="eyebrow">{story.category} · {story.sourceDate}</p><h1>{story.title}</h1><p class="intro-description">{story.summary}</p></header><figure><Photo name={story.image} alt={story.imageAlt} class="article-photo" eager sizes="(max-width: 700px) 100vw, 1030px" /><figcaption class="centered">{project.imageCaption}</figcaption></figure><div class="article-body prose">{story.paragraphs.map(paragraph => <p>{paragraph}</p>)}<div class="notice"><strong>From the project archive</strong>This story was prepared from historical public materials. It is not a new interview or a current field update. <a href={project.source}>Read the source</a>.</div><hr /><a class="text-link" href={`/projects/${project.slug}/`}>Explore {project.name} <Icon /></a><br /><a class="text-link" href="/stories/">Back to all stories <Icon /></a></div></article><Newsletter /></Layout>
