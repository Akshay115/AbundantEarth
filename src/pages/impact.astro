---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import CallToAction from '../components/CallToAction.astro';
import { site, projects } from '../lib/content';
const arc = projects[0];
---
<Layout title="Our impact" description="Explore the foundation’s documented reach, partner-reported outcomes, and transparent approach to impact reporting.">
  <PageIntro eyebrow="The difference, rooted in action" title="Every connection can grow something good." description="Impact is more than a number. It is a community with new skills, a healthier landscape, and the possibility of a more secure future." />
  <section class="section container"><p class="eyebrow">The foundation’s documented reach</p><h2>Small beginnings. A growing network.</h2><div class="impact-page-stats">{site.impact.map(stat => <div class="stat"><strong>{stat.value}</strong><span>{stat.label}</span></div>)}</div><p class="source-note">Figures from <a href={site.impactSource}>AEF’s {site.impactAsOf}</a>, reviewed September 18, 2026, covering its work since 2018. These are source-reported cumulative figures, not live counters. Older source footers still show 150+ projects and 30 countries; this page identifies the newer donation-page statement explicitly.</p><a class="text-link" href="/report-impact/">Share a project impact update <Icon /></a></section>
  <section class="section projects-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">A closer look · the ARC network</p><h2>Growing food.<br /><em>Regenerating possibility.</em></h2></div><a class="text-link" href="/projects/agroforestry-regeneration-communities/">Explore ARC <Icon /></a></div><div class="feature-grid">{arc.outcomes.map(outcome => <article class="feature-card"><span class="line-icon"><Icon name="leaf" /></span><h3>{outcome}</h3></article>)}</div><p class="source-note">{arc.outcomeNote} <a href={arc.source}>Source ↗</a></p><div class="before-after"><figure><Photo name="forest-before" alt="Contour Lines site in Guatemala before the later documented agroforestry growth" /><figcaption>February 2019 · Contour Lines, Guatemala</figcaption></figure><figure><Photo name="food-forest" alt="The Contour Lines site with extensive green agroforestry growth in September 2021" /><figcaption>September 2021 · Contour Lines, Guatemala</figcaption></figure></div><p class="source-note">Dated photographs published by <a href="https://agroforestryrc.org/">ARC</a>. The photographs illustrate change at this site; they do not independently establish AEF’s share of that change.</p></div></section>
  <section class="section container article-grid" id="reporting"><div class="prose"><h2>Good stories deserve clear context.</h2><p>We distinguish what the foundation has provided from what the projects and their wider networks report achieving. A grant, a training program, and a partner’s lifetime reach are different measures.</p><h3>What our figures mean</h3><ul><li><strong>Foundation reach:</strong> projects and countries reported by AEF in its historical materials.</li><li><strong>Partner-reported results:</strong> outcomes attributed to the project or network that reported them.</li><li><strong>Plans and intentions:</strong> what a grant was intended to support, rather than a claim of completed work.</li></ul><h3>A record that can keep improving</h3><p>Every project page links to its source and identifies the reporting context. Current project status, updated outcomes, and funding needs should be confirmed with the people leading the work.</p><a class="text-link" href="/sources/">Explore our source notes <Icon /></a></div><aside class="aside-card"><h3>See the people behind the numbers.</h3><p>Explore community-led food growing, environmental education, and resilience projects.</p><a class="button" href="/stories/">Read their stories <Icon /></a><a class="text-link" href="/contact/?topic=Project%20update">Contribute an update <Icon /></a></aside></section>
  <CallToAction />
</Layout>
