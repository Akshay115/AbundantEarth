---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import InquiryForm from '../components/InquiryForm.astro';
import { site } from '../lib/content';
---
<Layout title="Contact us"><PageIntro eyebrow="Good things begin with a conversation" title="Let’s grow a connection." description="A question, an idea, a project update, or an introduction—we’d like to help you find the right next step." /><section class="section container two-column"><div class="prose"><h2>Reach out directly.</h2><p><a href={`mailto:${site.email}`} style="overflow-wrap:anywhere">{site.email}</a></p><p>This contact address is published on the foundation’s current donation page, reviewed September 18, 2026.</p><h3>Mailing address</h3><p>Abundant Earth Foundation<br />{site.postalAddress}</p><p class="source-note">Address published on the <a href="https://abundantearthfoundation.org/donate/">original donation page</a>. Confirm instructions with the team before mailing a check.</p><h3>A few helpful starting points</h3><ul><li><a href="/get-support/">Check funding availability</a> before preparing a request.</li><li><a href="/report-impact/">Share an impact update</a> for an existing project.</li><li><a href="/donor-support/">Get help with receipts or recurring donations</a>.</li><li><a href="/internships/">Explore internship information</a>.</li></ul><h3>Find us in the community.</h3><div class="social-links">{site.social.map(s => <a href={s.url}>{s.name} ↗</a>)}</div></div><InquiryForm /></section></Layout>
