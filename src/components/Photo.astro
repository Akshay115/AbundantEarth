---
interface Props { name: string; alt: string; class?: string; eager?: boolean; sizes?: string; }
const { name, alt, class: className, eager = false, sizes = '(max-width: 700px) 100vw, 50vw' } = Astro.props;
---
{name === 'community' ? <div class:list={['archival-photo', className]}><img src="/images/community-480.webp" alt={alt} width="150" height="150" loading={eager ? 'eager' : 'lazy'} /><span aria-hidden="true">From the project archive</span></div> : <img class={className} src={`/images/${name}-960.webp`} srcset={`/images/${name}-480.webp 480w, /images/${name}-960.webp 960w, /images/${name}-1600.webp 1600w`} sizes={sizes} alt={alt} width="960" height="720" loading={eager ? 'eager' : 'lazy'} decoding="async" fetchpriority={eager ? 'high' : 'auto'} />}
