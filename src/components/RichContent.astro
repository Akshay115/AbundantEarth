---
import { renderLegacyHtml } from '../lib/legacy';
import { reserveImageSpace } from '../lib/image-dimensions';
interface Props { html: string; variant?: 'default' | 'team'; }
const html = await reserveImageSpace(renderLegacyHtml(Astro.props.html, Astro.props.variant));
---
<div class="prose legacy-content" set:html={html} />
