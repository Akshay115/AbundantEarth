---
import type { Story } from '../lib/content';
import Photo from './Photo.astro';
import Icon from './Icon.astro';
interface Props { story: Story; }
const { story } = Astro.props;
---
<article class="story-card">
  <a href={`/stories/${story.slug}/`} tabindex="-1" aria-hidden="true"><Photo name={story.image} alt="" sizes="(max-width: 700px) 100vw, 33vw" /></a>
  <p class="eyebrow">{story.category} <span>· Archive story</span></p>
  <h3><a href={`/stories/${story.slug}/`}>{story.title}</a></h3>
  <p>{story.summary}</p>
  <a class="text-link" href={`/stories/${story.slug}/`} aria-label={`Read: ${story.title}`}>Read the story <Icon /></a>
</article>
